{
  // This package is a DNA layer: dna/ is hand-authored source and is the
  // last layer of its own instantiation.
  "version": 1,

  // The rljson umbrella: it pulls in the topic layers, so adding this one
  // layer gives a repo the whole set. Parents first, this layer wins.
  //
  // dna_vscode is deliberately absent: the rljson repos carry their own
  // .vscode settings, with the ESLint and Dart configuration their
  // developers work with every day, and the DNA must not replace it.
  //
  // dna_scripts is deliberately absent too: dna_gg no longer pulls it in,
  // and the rljson repos keep their own workflow scripts. Only the one
  // script dna_gg calls itself, delete-feature-branch.js, comes along.
  "layers": [
    "dna_readme",
    "dna_guides",
    "dna_translate",
    "dna_index",
    "dna_blog",
    "dna_install",
    "dna_clean_code",
    "dna_gg"
  ]
}
